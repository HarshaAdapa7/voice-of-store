# TalentAP Mega Hackathon 2026 - Coding Guidelines .gitignore
# Excluded by rule: datasets, models, environments, build artifacts, secrets

# Large data and model directories
data/
models/

# Secrets and local environments
.env
.env.local
.env.*.local
.venv/
venv/
ENV/
env/

# Dependencies and caches
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Evaluation outputs and local test runs
score.json
out/
submission/score.json

# Build outputs
dist/
build/
*.egg-info/

# Operating system and editor artifacts
.DS_Store
Thumbs.db
*.log
*.zip
*.tar.gz
.vscode/
.idea/
.github/
FULL_CODE/.github/
FULL_CODE/AUTOMATION.md
