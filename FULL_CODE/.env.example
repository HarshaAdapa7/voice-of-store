# The detector, classifier and briefs need no environment variables, secrets, or internet.
# Optional settings for the web demo (FULL_CODE/serve.py). Export values yourself; .env is git-ignored.
# R5_ALLOWED_HOSTS=demo.example.com      # host names accepted in the Host header (required to expose the app)
# R5_API_KEY=change-me-long-random       # when set, POST /api/classify needs header X-API-Key
# R5_HTTPS=1                             # only when TLS is terminated in front of the app (adds HSTS)
# R5_TRUST_PROXY=1                       # only behind a trusted reverse proxy (use its X-Forwarded-For)
# R5_AUTH_USER=judge                     # turns on the login; make the hash with: python FULL_CODE/scripts/make_auth_hash.py judge
# R5_AUTH_HASH=scrypt:...                # printed by that script (a salted hash, never the password)
# R5_LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING
# GEMINI_API_KEY=                        # optional: enables Gemini summary mode; never send raw feedback or questions
# GEMINI_MODEL=gemini-2.5-flash           # optional model name
# R5_SMTP_HOST=smtp.example.com           # optional approved-alert delivery; STARTTLS is required
# R5_SMTP_PORT=587
# R5_SMTP_FROM=alerts@example.com
# R5_ALERT_RECIPIENTS=ops@example.com     # comma-separated; exact recipients shown before per-batch approval
# R5_SMTP_USERNAME=
# R5_SMTP_PASSWORD=
# R5_ALERT_AUDIT_PATH=out/notification_audit.jsonl
