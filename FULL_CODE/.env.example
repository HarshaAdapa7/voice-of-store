# The detector, classifier and briefs need no environment variables, no secrets and no internet.
# Optional settings for the web demo (FULL_CODE/serve.py). Copy to .env and export them yourself; .env is git-ignored.
# R5_ALLOWED_HOSTS=demo.example.com      # host names accepted in the Host header (required to expose the app)
# R5_API_KEY=change-me-long-random       # when set, POST /api/classify needs header X-API-Key
# R5_HTTPS=1                             # only when TLS is terminated in front of the app (adds HSTS)
# R5_TRUST_PROXY=1                       # only behind a trusted reverse proxy (use its X-Forwarded-For)
# R5_AUTH_USER=judge                     # turns on the login; make the hash with: python FULL_CODE/scripts/make_auth_hash.py judge
# R5_AUTH_HASH=scrypt:...                # printed by that script (a salted hash, never the password)
# R5_LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING
